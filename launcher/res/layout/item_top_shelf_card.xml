<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:focusable="true" android:clickable="true" android:clipChildren="false" android:clipToPadding="false" android:layout_width="160dp" android:layout_height="wrap_content" android:layout_marginEnd="14dp">
    <FrameLayout android:id="@+id/cardPosterContainer" android:background="@drawable/shelf_card_bg" android:clipChildren="false" android:layout_width="160dp" android:layout_height="90dp" android:outlineProvider="background" >
        <ImageView android:id="@+id/ivShelfPoster" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
        <View android:background="@drawable/series_card_scrim" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <TextView android:textSize="9sp" android:textColor="@color/text_white" android:layout_gravity="top|start" android:id="@+id/tvShelfBadge" android:background="@drawable/shelf_badge_bg" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="CONTINUE" android:textAllCaps="true" android:fontFamily="@font/inter_semibold" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginStart="8dp" android:letterSpacing="0.080000"/>
        <View android:id="@+id/vShelfFocusRing" android:background="@drawable/shelf_focus_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0"/>
    </FrameLayout>
    <TextView android:textSize="12sp" android:textColor="@color/text_white" android:ellipsize="end" android:id="@+id/tvShelfTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Title" android:singleLine="true" android:shadowColor="#E0000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="4" android:fontFamily="@font/inter_semibold"/>
    <TextView android:textSize="10sp" android:textColor="#99FFFFFF" android:ellipsize="end" android:id="@+id/tvShelfSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="Subtitle" android:singleLine="true" android:shadowColor="#D0000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" android:fontFamily="@font/inter_regular"/>
</LinearLayout>
