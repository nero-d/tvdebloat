<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:focusable="true"
    android:clickable="true"
    android:defaultFocusHighlightEnabled="false"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Card Container (18dp Rounded Apple TV Tile) -->
    <com.appletv.launcher.RoundedCardView
        android:id="@+id/cardContainer"
        android:layout_width="200dp"
        android:layout_height="112dp"
        android:clipToOutline="true"
        android:defaultFocusHighlightEnabled="false"
        android:background="@drawable/ic_launcher">

        <com.appletv.launcher.RoundedImageView
            android:id="@+id/ivPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/series_card_scrim" />

        <!-- App Provider Badge -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/series_badge_bg"
            android:fontFamily="@font/outfit_regular"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:letterSpacing="0.08"
            android:text="NETFLIX" />

        <!-- Title over the bottom of the card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvSeriesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:fontFamily="@font/outfit_regular"
                android:singleLine="true"
                android:ellipsize="end"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="Seinfeld" />

            <TextView
                android:id="@+id/tvSeriesSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/outfit_light"
                android:singleLine="true"
                android:ellipsize="end"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="9 Seasons • Netflix" />
        </LinearLayout>

        <!-- Authentic Apple TV Focused Ring Overlay -->
        <View
            android:id="@+id/vFocusRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/series_focus_ring"
            android:alpha="0.0" />
    </com.appletv.launcher.RoundedCardView>
</LinearLayout>
