<?xml version="1.0" ?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:focusable="true" android:clickable="true" android:clipChildren="false" android:clipToPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:defaultFocusHighlightEnabled="false">
    <FrameLayout android:id="@+id/cardContainer" android:background="@android:color/transparent" android:layout_width="96dp" android:layout_height="60dp" android:defaultFocusHighlightEnabled="false">
        <ImageView android:id="@+id/ivIconUnfocused" android:padding="3dp" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:alpha="1"/>
        <ImageView android:id="@+id/ivIconFocused" android:padding="3dp" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:alpha="0"/>
        <ImageView android:id="@+id/ivBanner" android:padding="3dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter"/>
        <ImageView android:layout_gravity="center" android:id="@+id/ivIconFallback" android:visibility="gone" android:layout_width="36dp" android:layout_height="36dp"/>
    </FrameLayout>
    <TextView android:id="@+id/tvLabel" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp"/>
</FrameLayout>
